# Phase 2 hash copies of candidate TFLite weights (not APK assets)
research/model-candidates/*.tflite
research/model-candidates/*.tflite.*

# Generated logs
outputs/logs/**
!outputs/logs/.gitkeep

# Local agent-loop state. The hook and the start phrase create these.
.cursor/loop-state.json
.cursor/agent-lock.json
.cursor/hooks/last-session.json
.cursor/hooks/last-payload.json

# Gradle output directories are ignored above. Keep the debug-build script.
!scripts/build/
!scripts/build/**

# Private/local QA evidence: share only deliberately redacted docs, never captures.
/outputs/reports/**
!/outputs/reports/.gitkeep
/test-data/**
!/test-data/.gitkeep
!/test-data/README.md
!/test-data/scene-manifest.example.tsv
# Educational weights and private test inputs must not enter Git by accident.
/android-app/app/src/debug/assets/**
/research/datasets/

# IDE-generated source/class mirrors are not a second source tree.
/android-app/sim-core/bin/
